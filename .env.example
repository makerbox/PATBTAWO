# Provider selection: asana, trello, clickup, jira, monday, or command.
ORCHESTRATOR_PROVIDER=asana

# Generic lifecycle state IDs or names. Provider-specific aliases are also
# supported, such as ASANA_SECTION_READY_GID or TRELLO_LIST_READY_ID.
ORCHESTRATOR_STATE_READY_ID=
ORCHESTRATOR_STATE_BUILDING_ID=
ORCHESTRATOR_STATE_VERIFYING_ID=
ORCHESTRATOR_STATE_FAILED_ID=
ORCHESTRATOR_STATE_DEPLOYING_ID=
ORCHESTRATOR_STATE_DONE_ID=
ORCHESTRATOR_STATE_BLOCKED_ID=

# Generic project/board/list identifier exposed to stage commands.
ORCHESTRATOR_PROJECT_ID=

# Asana provider.
ASANA_ACCESS_TOKEN=
ASANA_PROJECT_GID=
# ASANA_SECTION_READY_GID=
# ASANA_SECTION_BUILDING_GID=
# ASANA_SECTION_VERIFYING_GID=
# ASANA_SECTION_FAILED_GID=
# ASANA_SECTION_DEPLOYING_GID=
# ASANA_SECTION_DONE_GID=
# ASANA_SECTION_BLOCKED_GID=

# Trello provider.
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
# TRELLO_LIST_READY_ID=
# TRELLO_LIST_BUILDING_ID=
# TRELLO_LIST_VERIFYING_ID=
# TRELLO_LIST_FAILED_ID=
# TRELLO_LIST_DEPLOYING_ID=
# TRELLO_LIST_DONE_ID=
# TRELLO_LIST_BLOCKED_ID=

# ClickUp provider. Lifecycle state values may be status names or status IDs.
CLICKUP_ACCESS_TOKEN=
CLICKUP_LIST_ID=
# CLICKUP_STATUS_READY=Ready
# CLICKUP_STATUS_BUILDING=Building
# CLICKUP_STATUS_VERIFYING=Verifying
# CLICKUP_STATUS_FAILED=Failed
# CLICKUP_STATUS_DEPLOYING=Deploying
# CLICKUP_STATUS_DONE=Done
# CLICKUP_STATUS_BLOCKED=Blocked

# Jira provider. READY is a status name unless JIRA_READY_JQL is set.
# Other lifecycle values can be transition IDs, transition names, or destination
# status names.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_READY_JQL=
JIRA_SEARCH_ENDPOINT=
# JIRA_STATUS_READY=Ready
# JIRA_TRANSITION_BUILDING_ID=
# JIRA_TRANSITION_VERIFYING_ID=
# JIRA_TRANSITION_FAILED_ID=
# JIRA_TRANSITION_DEPLOYING_ID=
# JIRA_TRANSITION_DONE_ID=
# JIRA_TRANSITION_BLOCKED_ID=

# monday.com provider. Lifecycle state values are labels in the status column.
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=
MONDAY_STATUS_COLUMN_ID=status
# MONDAY_STATUS_READY=Ready
# MONDAY_STATUS_BUILDING=Building
# MONDAY_STATUS_VERIFYING=Verifying
# MONDAY_STATUS_FAILED=Failed
# MONDAY_STATUS_DEPLOYING=Deploying
# MONDAY_STATUS_DONE=Done
# MONDAY_STATUS_BLOCKED=Blocked

# Command provider for unsupported systems. Commands run locally and communicate
# through JSON stdout plus environment variables.
ORCHESTRATOR_COMMAND_NEXT_TASK=
ORCHESTRATOR_COMMAND_GET_TASK=
ORCHESTRATOR_COMMAND_MOVE_TASK=
ORCHESTRATOR_COMMAND_COMMENT_TASK=

# Local orchestration behavior.
ORCHESTRATOR_RETRY_LIMIT=1
ORCHESTRATOR_DRY_RUN=false
ORCHESTRATOR_BASE_BRANCH=main
ORCHESTRATOR_WORKTREE_ROOT=../.orchestrator-worktrees
ORCHESTRATOR_ARTIFACT_ROOT=.orchestrator/artifacts
ORCHESTRATOR_STAGE_TIMEOUT_SECONDS=3600
ORCHESTRATOR_KEEP_WORKTREES=false
ORCHESTRATOR_OBJECTIVE_VERIFIER=true

# Stage agent commands run as fresh subprocesses. Point these at Codex, Claude
# Code, BMAD, LangGraph, shell scripts, or CI wrappers. Each command must write
# JSON to ORCHESTRATOR_REPORT_PATH.
ORCHESTRATOR_BUILDER_AGENT_COMMAND=
ORCHESTRATOR_VERIFIER_AGENT_COMMAND=
ORCHESTRATOR_DEPLOYER_AGENT_COMMAND=

# Backward-compatible command aliases.
ORCHESTRATOR_BUILDER_COMMAND=python scripts/builder.py
ORCHESTRATOR_VERIFIER_COMMAND=python scripts/verifier.py

# Optional deploy/smoke stage. Leave disabled unless this repository supports it.
ORCHESTRATOR_DEPLOY_ENABLED=false
ORCHESTRATOR_DEPLOY_COMMAND=
ORCHESTRATOR_SMOKE_COMMAND=
